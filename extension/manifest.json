{
  "manifest_version": 3,
  "name": "README Clew 2",
  "version": "0.1.0",
  "description": "Checks whether a GitHub README matches its code. Open a repo page, click the clew, press SCAN.",
  "action": {
    "default_title": "README Clew 2",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab"],
  "host_permissions": ["https://readme-clew-2.vercel.app/*"]
}

{
  "pkg": {
    "name": "workspace",
    "private": true,
    "scripts": {
      "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
      "build": "pnpm run typecheck && pnpm -r --if-present run build",
      "typecheck:libs": "tsc --build",
      "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
    }
  },
  "workspaces": [
    {
      "path": "artifacts/api-server",
      "pkg": {
        "name": "@workspace/api-server",
        "scripts": {
          "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
          "build": "node ./build.mjs",
          "start": "node --enable-source-maps ./dist/index.mjs",
          "typecheck": "tsc -p tsconfig.json --noEmit",
          "test:fixtures": "node run-extraction-tests.js"
        },
        "dependencies": {
          "@anthropic-ai/sdk": "^0.92.0",
          "@workspace/api-zod": "workspace:*",
          "@workspace/db": "workspace:*",
          "acorn": "^8.16.0",
          "acorn-jsx": "^5.3.2",
          "acorn-walk": "^8.3.5",
          "cookie-parser": "^1.4.7",
          "cors": "^2",
          "drizzle-orm": "catalog:",
          "express": "^5",
          "pino": "^9",
          "pino-http": "^10"
        },
        "devDependencies": {
          "@types/acorn": "^6.0.4",
          "@types/cookie-parser": "^1.4.10",
          "@types/cors": "^2.8.19",
          "@types/express": "^5.0.6",
          "@types/node": "catalog:",
          "esbuild": "^0.27.3",
          "esbuild-plugin-pino": "^2.3.3",
          "pino-pretty": "^13",
          "thread-stream": "3.1.0"
        }
      }
    },
    {
      "path": "artifacts/frontend",
      "pkg": {
        "name": "@workspace/frontend",
        "scripts": {
          "dev": "vite --config vite.config.ts --host 0.0.0.0",
          "build": "vite build --config vite.config.ts",
          "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
          "typecheck": "tsc -p tsconfig.json --noEmit"
        },
        "dependencies": {},
        "devDependencies": {
          "@types/node": "catalog:",
          "vite": "catalog:"
        }
      }
    },
    {
      "path": "lib/api-client-react",
      "pkg": {
        "name": "@workspace/api-client-react",
        "scripts": {},
        "dependencies": {
          "@tanstack/react-query": "catalog:"
        },
        "devDependencies": {}
      }
    },
    {
      "path": "lib/api-spec",
      "pkg": {
        "name": "@workspace/api-spec",
        "scripts": {
          "codegen": "orval --config ./orval.config.ts && pnpm -w run typecheck:libs"
        },
        "dependencies": {},
        "devDependencies": {
          "orval": "^8.5.2"
        }
      }
    },
    {
      "path": "lib/api-zod",
      "pkg": {
        "name": "@workspace/api-zod",
        "scripts": {},
        "dependencies": {
          "zod": "catalog:"
        },
        "devDependencies": {}
      }
    },
    {
      "path": "lib/db",
      "pkg": {
        "name": "@workspace/db",
        "scripts": {
          "push": "drizzle-kit push --config ./drizzle.config.ts",
          "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
        },
        "dependencies": {
          "drizzle-orm": "catalog:",
          "drizzle-zod": "^0.8.3",
          "pg": "^8.20.0",
          "zod": "catalog:"
        },
        "devDependencies": {
          "@types/node": "catalog:",
          "@types/pg": "^8.18.0",
          "drizzle-kit": "^0.31.9"
        }
      }
    },
    {
      "path": "scripts",
      "pkg": {
        "name": "@workspace/scripts",
        "scripts": {
          "hello": "tsx ./src/hello.ts",
          "typecheck": "tsc -p tsconfig.json --noEmit"
        },
        "dependencies": {},
        "devDependencies": {
          "@types/node": "catalog:",
          "tsx": "catalog:"
        }
      }
    }
  ],

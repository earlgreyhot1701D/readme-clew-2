# Glasser API key for calling Jev (jev-1.13.0), required for live scans
GLASSER_API_KEY=

# Anthropic API key for Claude Haiku summaries, optional (fail-open when unset)
ANTHROPIC_API_KEY=

# GitHub Personal Access Token for higher API rate limits, optional for public repos
GITHUB_TOKEN=

# Anthropic workspace ID header when using an unscoped key, optional
ANTHROPIC_WORKSPACE_ID=
